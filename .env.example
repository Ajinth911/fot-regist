PORT=5000
NODE_ENV=development

# Security Secrets (Generate using: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_here
TOKEN_SECRET=your_super_secret_hmac_ticket_signing_key_here

# Initial Admin Credentials (used only on initial DB seeding)
ADMIN_EMAIL=admin@fot.org
ADMIN_PASSWORD=change_this_secure_admin_password_2026

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000

# Optional SMTP Settings (Gmail or any SMTP service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Friends of Tech" <your_email@gmail.com>

# Optional Google Sheets Service Account (for live scan synchronization)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Supabase Cloud Database (Backend Service Role Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Vite Frontend Supabase (Client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Razorpay Payment Gateway (Instant Auto-Verification & Ticket Dispatch)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_optional_webhook_secret_here
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
